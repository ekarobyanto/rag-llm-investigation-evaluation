# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://admin:root@localhost:5432/thesis"

# OpenAI API
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-5.6-luna"

# Live Telemetry WebSocket Port
WS_PORT=3001

# Application Authentication Layer
# Master password to access the app and API
APP_PASSWORD="your-secure-master-password"
# Optional random secret used to sign session cookies
AUTH_SECRET="your-random-32-char-secret-string"
